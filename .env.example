# Copy this file to .env.local and fill in the keys you have.
# Every key is optional: anything left blank runs in demo mode.

# Live scores, fixtures, tables, top scorers (free): https://www.football-data.org/client/register
# Free plan = 12 competitions, scores slightly delayed. "Free with Livescores" (~€12/month) gives real-time.
FOOTBALL_DATA_API_KEY=

# Bookmaker odds (free 500 credits/month): https://the-odds-api.com
ODDS_API_KEY=
# Region of bookmakers: uk, eu, us, au
ODDS_REGION=uk
# How long to cache odds. 360 min keeps you well inside the free quota.
ODDS_CACHE_MINUTES=360

# AI chatbot (pay as you go): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: claude-haiku-5-5 is cheaper and faster, claude-sonnet-5-5 is smarter
ANTHROPIC_MODEL=claude-sonnet-5-5
